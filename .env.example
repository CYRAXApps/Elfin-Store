# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / APP_BASE_URL: The URL where this applet is hosted.
# Used for self-referential links, sitemaps, and API endpoints.
APP_URL="MY_APP_URL"
APP_BASE_URL="https://electrostore.com"
APP_ENV="production"

# Google Maps Platform API Key
VITE_GOOGLE_MAPS_API_KEY=""

# Razorpay Payment Gateway Keys (TEST or LIVE)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
PAYMENT_MODE="test"

# Customer Notification Provider Keys (Optional: system safely falls back to Firestore In-App realtime)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SENDGRID_API_KEY=""
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="support@electrostore.com"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
